# LabLink Backend – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
# Production: generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Development: local MongoDB
MONGO_URI=mongodb://localhost:27017/lablink
# Production: MongoDB Atlas connection string
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lablink?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Development: Vite dev server
CORS_ORIGIN=http://localhost:5173
# Production: your deployed frontend URL (same origin when Flask serves React)
# CORS_ORIGIN=https://lablink.onrender.com

# ── IBM watsonx.ai (optional – leave blank to run in stub mode) ───────────────
# NEVER commit real API keys
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
