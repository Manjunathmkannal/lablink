# LabLink Frontend – Environment Variables
# Copy this file to .env and fill in your values.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put secrets here.

# ── Backend API URL ───────────────────────────────────────────────────────────
# Development: points to local Flask server (also handled by Vite proxy)
VITE_API_BASE_URL=http://localhost:5000
# Production: same-origin deployment (Flask serves both API and React build)
# Leave blank or set to your Render URL — axiosInstance falls back correctly.
# VITE_API_BASE_URL=https://lablink.onrender.com
